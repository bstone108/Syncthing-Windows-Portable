<Window x:Class="PortableSyncthing.Windows.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="Portable Syncthing" Height="760" Width="1240" MinHeight="600" MinWidth="900"
        Background="#0F172A" Foreground="#E2E8F0" Loaded="Window_Loaded" Closing="Window_Closing">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="190" />
        </Grid.RowDefinitions>
        <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="14">
            <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="Portable Syncthing" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock x:Name="StatusText" Text="Preparing portable workspace…" Foreground="#94A3B8" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Restart Syncthing" Click="Restart_Click" Margin="4" Padding="12,7" />
                    <Button Content="Check and Update" Click="Update_Click" Margin="4" Padding="12,7" />
                    <Button Content="Open Data Folder" Click="OpenDataFolder_Click" Margin="4" Padding="12,7" />
                </StackPanel>
            </DockPanel>
        </Border>
        <Grid Grid.Row="1" Margin="0,12,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250" />
                <ColumnDefinition Width="12" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="16">
                <StackPanel>
                    <TextBlock Text="STATUS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                    <TextBlock x:Name="ProcessStatus" Text="Syncthing not started" FontSize="16" Margin="0,16,0,8" />
                    <TextBlock Text="Portable folders are remapped before every Syncthing launch. Mappings inside the portable root follow its current drive letter; external folders are left untouched." TextWrapping="Wrap" Foreground="#CBD5E1" />
                    <Separator Margin="0,20" />
                    <TextBlock Text="This is a standalone windowed app. It does not install a service or use a tray icon." TextWrapping="Wrap" Foreground="#94A3B8" />
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#FFFFFF" CornerRadius="10" ClipToBounds="True">
                <wv2:WebView2 x:Name="SyncthingBrowser" />
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="{StaticResource PanelBrush}" CornerRadius="10" Padding="12">
            <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                <TextBlock Text="LIVE SYNCTHING PROCESS LOG" Foreground="{StaticResource AccentBrush}" FontWeight="Bold" />
                <ListBox x:Name="LogList" Grid.Row="1" Margin="0,8,0,0" Background="#020617" Foreground="#CBD5E1" BorderThickness="0" FontFamily="Consolas" FontSize="12" />
            </Grid>
        </Border>
    </Grid>
</Window>
